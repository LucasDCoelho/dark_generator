# --- Claude (gera ideias e roteiros) ---
# Obrigatório só para o modo piloto automático. Via MCP, o próprio Claude pode escrever os roteiros.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Pexels (vídeos de fundo; opcional, sem chave usa fundos sombrios procedurais) ---
PEXELS_API_KEY=

# --- Canal ---
CHANNEL_TIMEZONE=America/Sao_Paulo
DATA_DIR=./data

# --- Painel web ---
HOST=127.0.0.1
PORT=8000
# Defina um token se expor o painel fora do localhost
DASHBOARD_TOKEN=

# --- Voz: edge | silent (silent = só para testes) ---
TTS_PROVIDER=edge

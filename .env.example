# --- Claude (gera ideias e roteiros) ---
# Necessária só para o piloto automático. Via MCP, o próprio Claude pode escrever os roteiros.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Pexels (vídeos de fundo; opcional, sem chave usa fundos sombrios procedurais) ---
PEXELS_API_KEY=

DATA_DIR=./data

# --- Painel web / MCP HTTP ---
HOST=127.0.0.1
PORT=8000
# Defina um token se expor o painel fora do localhost
DASHBOARD_TOKEN=
# URL pública (ex.: https://meu-servidor.com) — usada no callback do OAuth e nos links do MCP
PUBLIC_BASE_URL=

# --- YouTube ---
# Uploads por dia por projeto do Google Cloud (a cota é por projeto, compartilhada entre canais)
YOUTUBE_UPLOADS_PER_PROJECT_PER_DAY=6
# Chave simples da YouTube Data API para o scanner de tendências (de preferência de OUTRO projeto)
YOUTUBE_API_KEY=

# --- Voz: edge | silent (silent = só para testes) ---
TTS_PROVIDER=edge
